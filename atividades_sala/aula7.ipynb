   "source": [
    "import numpy as np\n",
    "\n",
    "def conv_output_size(n, k, p=0, s=1):\n",
    "    return np.floor((n-k+2*p)/s) + 1\n",
    "\n",
    "def conv_params(c_in, c_out, k):\n",
    "    return (k*k*c_in - 1)*c_out\n",
    "\n",
    "def dense_params(n_in, n_out):\n",
    "    return n_out(n_in + 1)\n",
    "\n"
   ]
  }
